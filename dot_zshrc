export HISTFILE="$HOME/.zsh_history"
export HISTSIZE=100000000
export SAVEHIST=100000000
setopt APPEND_HISTORY         
setopt INC_APPEND_HISTORY     
setopt SHARE_HISTORY          
setopt EXTENDED_HISTORY       
setopt HIST_IGNORE_ALL_DUPS   
setopt HIST_REDUCE_BLANKS     
setopt HIST_VERIFY            

if [[ ":$FPATH:" != *":/home/anish/.zsh/completions:"* ]]; then export FPATH="/home/anish/.zsh/completions:$FPATH"; fi
export ZSH="$HOME/.oh-my-zsh"

autoload -Uz compinit
compinit

ZSH_THEME="robbyrussell"
plugins=(dirhistory git zsh-autosuggestions zsh-syntax-highlighting fzf-tab)

source $ZSH/oh-my-zsh.sh

alias dev="cd ~/Documents/dev"
alias test="cd ~/Documents/test"
alias ex="exit"
alias dk="docker"
alias k='kubectl'
alias tf='terraform'
alias y='yazi'
alias py='python3'
alias c='wl-copy'
alias p='wl-paste'
alias i='incus'


export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"  # This loads nvm
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"  # This loads nvm bash_completion

# fzf for search history, file search etc..
source <(fzf --zsh)

# The next line updates PATH for the Google Cloud SDK.
if [ -f '/usr/local/bin/google-cloud-sdk/path.zsh.inc' ]; then . '/usr/local/bin/google-cloud-sdk/path.zsh.inc'; fi

# The next line enables shell command completion for gcloud.
if [ -f '/usr/local/bin/google-cloud-sdk/completion.zsh.inc' ]; then . '/usr/local/bin/google-cloud-sdk/completion.zsh.inc'; fi
complete -C aws_completer aws

# k3d completions
source "/home/anish/.zsh/completions/_k3d"

# bun
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"
# bun completions
[ -s "/home/anish/.bun/_bun" ] && source "/home/anish/.bun/_bun"
